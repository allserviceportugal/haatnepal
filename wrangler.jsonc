{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "haatnepal",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://bmlfzeoqveysbzrfzmpb.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_6A4Mn0giqkquOJQX3SlZ9g_WHDxTzNd",
    "NEXT_PUBLIC_APP_URL": "https://haatnepal.pages.dev"
  },
  "secrets": [
    "RESEND_API_KEY"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "haatnepal"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
